{
  "name": "project-surface-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The missing semantic layer for AI-readable software projects.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "packages/core",
    "packages/adapter-sdk",
    "packages/adapters/*",
    "packages/cli",
    "packages/mcp-server",
    "bench"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "rebuild": "tsc --build --force",
    "typecheck": "tsc --build --dry",
    "test": "npm run build && node scripts/run-tests.mjs",
    "surface": "node packages/cli/dist/index.js",
    "fixtures:update": "npm run build && node scripts/update-fixtures.mjs",
    "test:only": "node scripts/run-tests.mjs",
    "bench:record": "npm run build && node bench/record.mjs",
    "bench:score": "npm run build && node bench/score.mjs",
    "bench:check": "node bench/score.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
